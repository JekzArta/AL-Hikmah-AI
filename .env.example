# Salin jadi .env (lokal) ATAU isi sebagai environment variable di pengaturan
# cloud environment (sesi Claude Code cloud). JANGAN tempel nilai asli di chat/kode.

# OpenRouter — kunci API (dipakai sejak Fase 0 untuk `npm run cek`)
OPENROUTER_API_KEY=

# Supabase (keputusan pemilik proyek, lihat docs/keputusan-pemilik.md) — dipakai mulai Fase 1
# URL proyek: https://<project-ref>.supabase.co
SUPABASE_URL=
# Kunci server (service_role / secret key). Hanya untuk server/CLI, JANGAN pernah ke browser/UI.
SUPABASE_SERVICE_ROLE_KEY=
